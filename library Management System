# Simple Library Management System

library = {
    "Python Programming": True,
    "Data Structures": True,
    "Machine Learning": True,
    "Database Systems": True,
    "Computer Networks": True
}

while True:
    print("\n===== Library Management System =====")
    print("1. View Books")
    print("2. Issue Book")
    print("3. Return Book")
    print("4. Exit")

    choice = input("Enter your choice (1-4): ")

    if choice == "1":
        print("\nAvailable Books:")
        for book, available in library.items():
            if available:
                print("-", book)

    elif choice == "2":
        book = input("Enter the book name to issue: ")
        if book in library:
            if library[book]:
                library[book] = False
                print(f"You have successfully issued '{book}'.")
            else:
                print("Sorry, this book is already issued.")
        else:
            print("Book not found.")

    elif choice == "3":
        book = input("Enter the book name to return: ")
        if book in library:
            library[book] = True
            print(f"Thank you! '{book}' has been returned.")
        else:
            print("Book not found.")

    elif choice == "4":
        print("Thank you for using the Library Management System!")
        break

    else:
        print("Invalid choice. Please try again.")
